{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcane-ally.local/contracts/v1/command-envelope.schema.json",
  "title": "Arcane Ally Command Envelope v1",
  "type": "object",
  "required": ["commandId", "commandType", "schemaVersion", "expectedCampaignVersion", "expectedAggregateVersions", "payload"],
  "properties": {
    "commandId": { "type": "string", "format": "uuid" },
    "commandType": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
    "schemaVersion": { "const": "1.0.0" },
    "expectedCampaignVersion": { "type": "integer", "minimum": 0 },
    "expectedAggregateVersions": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "actor": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["dm", "player", "automation", "system", "integration"] },
        "id": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "sessionId": { "type": ["string", "integer", "null"] },
    "payload": {},
    "extensions": {
      "type": "object",
      "patternProperties": { "^x-[a-z0-9-]+$": {} },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
