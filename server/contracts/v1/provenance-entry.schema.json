{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcane-ally.local/contracts/v1/provenance-entry.schema.json",
  "title": "Arcane Ally Provenance Entry v1",
  "type": "object",
  "required": ["sourceType", "sourceId", "operation", "value"],
  "properties": {
    "sourceType": { "enum": ["base", "class", "race", "item", "buff", "condition", "effect", "automation", "override", "custom"] },
    "sourceId": { "type": ["string", "integer", "null"] },
    "sourceName": { "type": ["string", "null"] },
    "operation": { "enum": ["base", "add", "subtract", "multiply", "set", "min", "max", "advantage", "disadvantage", "auto_fail"] },
    "value": {},
    "priority": { "type": "integer" },
    "extensions": {
      "type": "object",
      "patternProperties": { "^x-[a-z0-9-]+$": {} },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
