{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcane-ally.local/contracts/v1/active-effect.schema.json",
  "title": "Arcane Ally Active Effect v1",
  "type": "object",
  "required": ["effectId", "type", "source", "targets", "parameters"],
  "properties": {
    "effectId": { "type": "string", "minLength": 1 },
    "type": { "enum": ["damage", "heal", "condition", "remove_condition", "buff", "remove_buff", "resource", "custom"] },
    "source": {
      "type": "object",
      "required": ["type", "id"],
      "properties": {
        "type": { "enum": ["character", "monster", "preset", "automation", "system", "integration"] },
        "id": { "type": ["string", "integer", "null"] },
        "name": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "id"],
        "properties": {
          "type": { "enum": ["character", "monster", "campaign", "session"] },
          "id": { "type": ["string", "integer"] }
        },
        "additionalProperties": false
      }
    },
    "parameters": { "type": "object" },
    "duration": {
      "type": ["object", "null"],
      "properties": {
        "unit": { "enum": ["round", "turn", "minute", "hour", "until_removed"] },
        "value": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "patternProperties": { "^x-[a-z0-9-]+$": {} },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
