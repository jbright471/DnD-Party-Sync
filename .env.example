# Port for the Express server (Backend)
PORT=3001

# Set production explicitly in the deployed runtime. Development keeps localhost-only defaults.
NODE_ENV=development

# Required in production: use a unique value of at least 12 characters. Never commit the value.
DM_PIN=

# Required in production: comma-separated browser origins, with scheme and port and no paths.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# Request and realtime traffic bounds.
HTTP_JSON_LIMIT=256kb
SOCKET_MAX_MESSAGE_BYTES=65536
DM_AUTH_MAX_ATTEMPTS=5
DM_AUTH_WINDOW_MS=900000
SOCKET_CONNECTION_MAX_ATTEMPTS=30
SOCKET_CONNECTION_WINDOW_MS=60000
SOCKET_EVENT_MAX_MESSAGES=120
SOCKET_EVENT_WINDOW_MS=10000
RATE_LIMIT_MAX_ENTRIES=10000
SECURITY_AUDIT_MAX_ROWS=10000

# Path to the SQLite database file (optional, defaults to ./dnd.db inside the server folder)
# DB_PATH=./dnd.db

# URL of the local Ollama instance for AI calculations, item parsing, and rules assistant
OLLAMA_URL=http://localhost:11434
